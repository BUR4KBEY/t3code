#!/usr/bin/env bash
# omp-devenv: launch omp inside devenv when appropriate, otherwise plain omp.
# Debug: set OMP_DEVENV_DEBUG=1 to see decisions on stderr.
# Also appended to ${XDG_STATE_HOME:-~/.local/state}/omp-devenv/debug.log,
# because omp's alternate screen buffer wipes anything printed before launch.

set -u
# Debug log file. Never stdout: stdout belongs to omp's stdio RPC.
debug_log() {
  [ -n "${OMP_DEVENV_DEBUG:-}" ] || return 0
  local dir="${XDG_STATE_HOME:-$HOME/.local/state}/omp-devenv"
  mkdir -p "$dir" 2>/dev/null || return 0
  printf '%s pid=%s cwd=%s %s\n' \
    "$(date -Is 2>/dev/null || echo '-')" "$$" "$PWD" "$*" \
    >>"$dir/debug.log" 2>/dev/null
  return 0
}

log() {
  [ -n "${OMP_DEVENV_DEBUG:-}" ] && echo "[omp-devenv] $*" >&2
  debug_log "$*"
  return 0
}

# plain "reason" args...  -> run omp without devenv
plain() {
  local reason=$1
  shift
  log "$reason; running plain omp"
  exec omp "$@"
}

has_devenv_files() {
  [ -e "$1/devenv.nix" ] || [ -e "$1/devenv.yaml" ]
}

# Whether this project uses devenv is decided by the presence of devenv.nix or
# devenv.yaml, not by direnv approval. devenv is commonly wired up globally
# (`devenv direnvrc`), so a project can have no .envrc of its own and still be
# a fully configured devenv project.

command -v devenv >/dev/null 2>&1 || plain "devenv not installed" "$@"

cwd=$PWD

# Already inside a devenv shell for this directory (e.g. the `devenv hook`
# auto-activated it): entering a second, nested shell only costs seconds.
if [ -n "${DEVENV_ROOT:-}" ]; then
  case "$cwd" in
    "$DEVENV_ROOT" | "$DEVENV_ROOT"/*) plain "devenv already active for $DEVENV_ROOT" "$@" ;;
  esac
fi

# Is cwd a linked git worktree?
is_worktree=0
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git_dir=$(git rev-parse --path-format=absolute --git-dir 2>/dev/null)
  common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
  [ -n "$git_dir" ] && [ "$git_dir" != "$common_dir" ] && is_worktree=1
fi

# stdout carries omp's ACP/RPC stream, and ACP clients such as T3 Code end the
# session on the first non-JSON line. devenv and enterShell hooks print to
# stdout, so run_devenv points fd 1 at stderr for them and gives omp the real
# stdout via fd 3.
run_devenv() {
  exec 3>&1 1>&2
  exec devenv --no-tui "$@" shell --no-reload -- sh -c 'exec omp "$@" 1>&3 3>&-' omp "${omp_args[@]}"
}
omp_args=("$@")

if [ "$is_worktree" -eq 1 ]; then
  has_devenv_files "$cwd" || plain "worktree without devenv files" "$@"

  # First entry in `git worktree list` is the main worktree
  main=$(git worktree list --porcelain | awk '/^worktree /{print substr($0, 10); exit}')
  [ -n "$main" ] || plain "could not determine main repo path" "$@"

  log "worktree: using devenv from $main"
  run_devenv --from "path:$main"
else
  has_devenv_files "$cwd" || plain "no devenv files" "$@"

  log "using devenv in $cwd"
  run_devenv
fi